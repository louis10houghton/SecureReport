# ─── SecureReport AI — environment variables ────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# DATABASE_URL uses the POOLED connection (…-pooler…) for serverless runtime.
# DIRECT_URL uses the direct connection for `prisma migrate` / `prisma db push`.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/securereport?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/securereport?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ── Stripe (use test-mode keys for the demo) ────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from your Stripe products (subscription prices):
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_BUSINESS="price_..."

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="SecureReport AI <onboarding@resend.dev>"
CONTACT_INBOX="you@yourdomain.com"

# ── App ─────────────────────────────────────────────────────────────────────
# Used to build Stripe success/cancel URLs. On Vercel this is your deployment URL.
PUBLIC_BASE_URL="http://localhost:5173"
# CORS: set to your site origin in production, or leave * for local dev.
CORS_ORIGIN="*"
